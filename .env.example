# ─── GitHub API ───────────────────────────────────────────────
# Create a personal access token at: https://github.com/settings/tokens
# Scopes required: read:user, public_repo
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_USERNAME=your_github_username

# ─── Contact Form (Gmail SMTP via Nodemailer) ─────────────────
# GMAIL_USER is the sending Gmail address (also where messages arrive).
# GMAIL_APP_PASSWORD is a 16-character Google "App Password" — NOT your
# normal account password. Generate one at:
#   Google Account -> Security -> 2-Step Verification (must be on first)
#   -> App Passwords -> select "Mail" -> Generate
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# ─── LeetCode ─────────────────────────────────────────────────
# Your LeetCode username (public profile, no auth required)
NEXT_PUBLIC_LEETCODE_USERNAME=your_leetcode_username

# ─── Site Config ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://tanmay.dev

# ─── Analytics (Vercel) ───────────────────────────────────────
# Automatically injected by Vercel — no config needed locally
