# ─── GitHub API ───────────────────────────────────────────────
# Create a personal access token at: https://github.com/settings/tokens
# Scopes required: read:user, public_repo
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_USERNAME=your_github_username

# ─── Contact Form (Web3Forms) ──────────────────────────────────
# Get a free access key instantly at https://web3forms.com — enter the
# email you want submissions delivered to, no signup or 2FA required.
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key

# ─── LeetCode ─────────────────────────────────────────────────
# Your LeetCode username (public profile, no auth required)
NEXT_PUBLIC_LEETCODE_USERNAME=your_leetcode_username

# ─── Site Config ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://tanmay.dev

# ─── Analytics (Vercel) ───────────────────────────────────────
# Automatically injected by Vercel — no config needed locally
