# ─── GitHub API ───────────────────────────────────────────────
# Create a personal access token at: https://github.com/settings/tokens
# Scopes required: read:user, public_repo
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_USERNAME=your_github_username

# ─── Contact Form (Resend) ──────────────────────────────────────
# Get a free API key at https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key
# Optional — defaults to Resend's shared sandbox sender (onboarding@resend.dev),
# which works immediately with no domain setup. Set this once you've verified
# your own sending domain in Resend.
RESEND_FROM_EMAIL=onboarding@resend.dev

# ─── LeetCode ─────────────────────────────────────────────────
# Your LeetCode username (public profile, no auth required)
NEXT_PUBLIC_LEETCODE_USERNAME=your_leetcode_username

# ─── Site Config ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://tanmay.dev

# ─── Analytics (Vercel) ───────────────────────────────────────
# Automatically injected by Vercel — no config needed locally
